<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <action android:id="@+id/action_global_playerFragment"
        app:destination="@id/playerFragment"
        app:enterAnim="@anim/slide_in_up"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/slide_out_down" />

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.zepyfyv2.MainFragment"
        android:label="fragment_main" 
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/action_mainFragment_to_albumDetailFragment"
            app:destination="@id/albumDetailFragment" />
        <action
            android:id="@+id/action_mainFragment_to_artistDetailFragment"
            app:destination="@id/artistDetailFragment" />
        <action
            android:id="@+id/action_mainFragment_to_playlistDetailFragment"
            app:destination="@+id/playlistDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.zepyfyv2.PlayerFragment"
        android:label="PlayerFragment" 
        tools:layout="@layout/fragment_player" >
        <action
            android:id="@+id/action_playerFragment_to_albumDetailFragment"
            app:destination="@id/albumDetailFragment"
            app:popUpTo="@id/playerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_playerFragment_to_artistDetailFragment"
            app:destination="@id/artistDetailFragment"
            app:popUpTo="@id/playerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_playerFragment_to_lyricsFragment"
            app:destination="@id/lyricsFragment" />
    </fragment>

    <fragment
        android:id="@+id/lyricsFragment"
        android:name="com.example.zepyfyv2.LyricsFragment"
        android:label="fragment_lyrics"
        tools:layout="@layout/fragment_lyrics" >
        <argument
            android:name="lyricsUrl"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="com.example.zepyfyv2.AlbumDetailFragment"
        android:label="AlbumDetailFragment">
        <argument
            android:name="album"
            app:argType="com.example.zepyfyv2.data.Album" />
    </fragment>

    <fragment
        android:id="@+id/artistDetailFragment"
        android:name="com.example.zepyfyv2.ArtistDetailFragment"
        android:label="ArtistDetailFragment">
        <argument
            android:name="artist"
            app:argType="com.example.zepyfyv2.data.Artist" />
    </fragment>

    <fragment
        android:id="@+id/playlistDetailFragment"
        android:name="com.example.zepyfyv2.PlaylistDetailFragment"
        android:label="PlaylistDetailFragment">
        <argument
            android:name="playlist"
            app:argType="com.example.zepyfyv2.data.Playlist" />
        <action
            android:id="@+id/action_playlistDetailFragment_to_editPlaylistSongsFragment"
            app:destination="@id/editPlaylistSongsFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down" />
    </fragment>

    <fragment
        android:id="@+id/editPlaylistSongsFragment"
        android:name="com.example.zepyfyv2.EditPlaylistSongsFragment"
        android:label="EditPlaylistSongsFragment"
        tools:layout="@layout/fragment_edit_playlist_songs">
        <argument
            android:name="playlist"
            app:argType="com.example.zepyfyv2.data.Playlist" />
    </fragment>

</navigation>