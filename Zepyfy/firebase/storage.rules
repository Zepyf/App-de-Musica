// Reglas de Cloud Storage para Zepyfy.
//
// Misma lista de UID que firestore.rules: mantenlas sincronizadas.
//
// Nota: la app reproduce el audio y carga las portadas con las URL de descarga
// (las que llevan "?alt=media&token=..."). Esas URL incluyen su propio token de
// acceso y no pasan por estas reglas; lo que sí protegen las reglas es listar,
// subir, borrar y obtener URL nuevas.
//
// Cómo publicarlas:
//   Firebase Console → Storage → Reglas → pega este archivo → Publicar.
//   (O con Firebase CLI: firebase deploy --only storage)

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.uid in ['PegaAquiTuUID'];
    }

    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
